# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
TELEGRAM_PROXY_URL=

TELEGRAM_CONNECT_TIMEOUT=30

WHATSAPP_PHONE_NUMBER_ID=

WHATSAPP_ACCESS_TOKEN=

WHATSAPP_API_VERSION=v22.0

WHATSAPP_TEMPLATE_NAME=welcome

WHATSAPP_TEMPLATE_LANGUAGE=en_US

WEBHOOK_PUBLIC_BASE_URL=https://example.ngrok-free.app

INSURANCE_PREMIUM_PAYMENT_LINK=https://ebiz.licindia.in/spy-LIC



SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_USERNAME=your-account@gmail.com

SMTP_PASSWORD=your-gmail-app-password

FROM_EMAIL=your-account@gmail.com

# External Gyantr AI Claims module (read-only). SIMI does not store Service Cases.
# Final resource URL = CLAIMS_BASE_URL + CLAIMS_API_PREFIX + /service-cases/...
# Auth: POST CLAIMS_BASE_URL + CLAIMS_AUTH_PATH with JSON email/password/tenant_slug
# Working Gyantr shape:
#   POST http://host:8000/api/v1/auth/login
#   GET  http://host:8000/api/v1/crm/service-cases/{id}
CLAIMS_BASE_URL=http://192.168.0.68:8000/api/v1
CLAIMS_API_PREFIX=/crm
CLAIMS_AUTH_PATH=/auth/login
CLAIMS_USERNAME=
CLAIMS_PASSWORD=
CLAIMS_TENANT_SLUG=
# CLAIMS_TENANT_ID=
CLAIMS_TIMEOUT=30

VITE_API_BASE_URL=http://localhost:8000

VITE_INSURANCE_PAYMENT_LINK=https://ebiz.licindia.in/spy-LIC

