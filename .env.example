REDIS_URL=redis://localhost:6379/0

ENABLE_DEV_REMINDER_SCHEDULER=false

SCHEDULER_SECRET=

JWT_SECRET=change-me-in-dev



OPENAI_API_KEY=

ANTHROPIC_API_KEY=



TELEGRAM_AGENT_BOT_TOKEN=

TELEGRAM_CUSTOMER_BOT_TOKEN=

TELEGRAM_DEFAULT_ORGANIZATION_ID=607

TELEGRAM_WEBHOOK_SECRET=

